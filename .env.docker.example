# Copy to .env.docker.local; that file is ignored and must never be published.
# Use: docker compose --env-file .env.docker.local <command>
# Existing installations: use verified current accounts after protecting ACLs.
# These variables do not rotate passwords in an initialized MySQL volume.
MGAEMS_DOCKER_DB_DATABASE=mgaems
MGAEMS_DOCKER_DB_USERNAME=mgaems_app
MGAEMS_DOCKER_DB_PASSWORD=
MGAEMS_DOCKER_ROOT_PASSWORD=
MGAEMS_DOCKER_MYSQL_PORT=3307
