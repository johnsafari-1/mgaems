{
    "name": "mgaems/mgaems",
    "type": "project",
    "description": "Manna Goodnews Academy Education Management System",
    "keywords": [
        "laravel",
        "school-management",
        "cbc",
        "education"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.35",
        "laravel/sanctum": "^4.3.3",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "maatwebsite/excel": "^3.1.70",
        "dompdf/dompdf": "^3.1.6",
        "league/commonmark": "^2.10.3",
        "league/flysystem": "^3.36"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^12.5",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
